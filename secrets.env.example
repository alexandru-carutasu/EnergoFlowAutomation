# Secrets configuration for local deployment
# Copy this file to secrets.env and fill in your values
# DO NOT commit secrets.env to git!

# Email credentials
IMAP_SERVER=imap.example.com
IMAP_ADDRESS=your_email@example.com
IMAP_PASSWORD=your_password
FORECAST_ADDRESS=forecast@example.com
IBD_ADDRESS=ibd@example.com

# Dropbox credentials
DROPBOX_APP_KEY=your_app_key
DROPBOX_APP_SECRET=your_app_secret

# Dropbox token file path (relative to project root)
DROPBOX_TOKEN_FILE=dropbox_token.json
