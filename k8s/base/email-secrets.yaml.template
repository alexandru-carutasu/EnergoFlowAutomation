# Email secrets - DO NOT commit real values!
# Copy this file to email-secrets.yaml and fill in your values, then apply:
#   kubectl apply -f k8s/base/email-secrets.yaml
#
# Or create directly with kubectl:
#   kubectl create secret generic email-secrets -n energoflow \
#     --from-literal=IMAP_SERVER=<your-server> \
#     --from-literal=IMAP_ADDRESS=<your-email> \
#     --from-literal=IMAP_PASSWORD=<your-password> \
#     --from-literal=FORECAST_ADDRESS=<forecast-email> \
#     --from-literal=IBD_ADDRESS=<ibd-email>

apiVersion: v1
kind: Secret
metadata:
  name: email-secrets
  namespace: energoflow
type: Opaque
stringData:
  IMAP_SERVER: "imap.example.com"
  IMAP_ADDRESS: "your_email@example.com"
  IMAP_PASSWORD: "your_password"
  FORECAST_ADDRESS: "forecast@example.com"
  IBD_ADDRESS: "ibd@example.com"
