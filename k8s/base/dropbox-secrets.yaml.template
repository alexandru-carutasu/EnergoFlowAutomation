# Dropbox secrets - DO NOT commit real values!
# Create the secret manually:
#   kubectl create secret generic dropbox-secrets -n energoflow \
#     --from-literal=DROPBOX_APP_KEY=<your-app-key> \
#     --from-literal=DROPBOX_APP_SECRET=<your-app-secret>
#
# And for the token file:
#   kubectl create secret generic dropbox-token -n energoflow \
#     --from-file=dropbox_token.json=<path-to-your-token-file>

apiVersion: v1
kind: Secret
metadata:
  name: dropbox-secrets
  namespace: energoflow
type: Opaque
stringData:
  DROPBOX_APP_KEY: "<your-app-key>"
  DROPBOX_APP_SECRET: "<your-app-secret>"
