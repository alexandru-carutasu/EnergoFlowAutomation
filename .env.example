# ── Email ──────────────────────────────────────
IMAP_SERVER=imap.example.com
IMAP_PORT=993
IMAP_ADDRESS=your_email@example.com
IMAP_PASSWORD=your_password
FORECAST_ADDRESS=forecast@example.com
IBD_ADDRESS=ibd@example.com

# ── Database (MySQL) ──────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=energoflow
DB_PASSWORD=changeme
DB_NAME=energoflow

# ── Dropbox ────────────────────────────────────
DROPBOX_APP_KEY=key
DROPBOX_APP_SECRET=secret
DROPBOX_TOKEN_FILE=dropbox_token.json
DROPBOX_EVAL_FILE_PATH=.

# ── Auth / Security ────────────────────────────
JWT_SECRET=change-me-in-production
SECRET_KEY=energoflow-dev-secret-key

# ── Grafana ────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Docker registry (CI/CD + Swarm) ───────────
REGISTRY=registry.gitlab.com/your-username/energoflow
VERSION=latest
